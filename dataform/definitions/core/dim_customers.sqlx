config {
  type: "incremental",
  uniqueKey: ["customer_id"],
  description: "One row per customer, latest version. Strategy: UPSERT (merge on customer_id). Rule 1: the version with the latest updated_at wins, even if it arrived in an older file.",
  assertions: {
    uniqueKey: ["customer_id"],
    nonNull: ["customer_id", "updated_at"]
  }
}

-- Customers loaded since the last run (everything on the first run).
WITH incoming AS (
  SELECT customer_id, customer_name, email, phone, city, signup_date, updated_at, _export_date, _loaded_at
  FROM ${ref("stg_customers")}
  ${when(incremental(), `WHERE ${helpers.newRowsOnly(self())}`)}
),

-- Compete each incoming customer against the version we already have.
candidates AS (
  SELECT * FROM incoming
  ${when(incremental(), `
  UNION ALL
  SELECT customer_id, customer_name, email, phone, city, signup_date, updated_at, _export_date, _loaded_at
  FROM ${self()}
  WHERE customer_id IN (SELECT customer_id FROM incoming)`)}
)

-- Keep one row per customer: the latest updated_at. Exact duplicates (C0153) tie, and one is kept.
SELECT * EXCEPT (version_rank)
FROM (
  SELECT *,
         ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY updated_at DESC, _loaded_at DESC) AS version_rank
  FROM candidates
)
WHERE version_rank = 1
