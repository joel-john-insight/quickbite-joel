config {
  type: "incremental",
  uniqueKey: ["order_id"],
  description: "One row per VALID order, current state. Strategy: UPSERT (merge on order_id), incremental. Rule 1: latest updated_at wins (handles O00863 arriving late with an older status). Rule 4: orders with an unknown restaurant or no customer are excluded (see rejected_orders).",
  bigquery: {
    partitionBy: "order_date",
    clusterBy: ["restaurant_id", "customer_id"]
  },
  assertions: {
    uniqueKey: ["order_id"],
    nonNull: ["order_id", "customer_id", "restaurant_id", "order_ts", "order_date", "status", "updated_at"],
    rowConditions: ["status IN ('placed', 'preparing', 'out_for_delivery', 'delivered', 'cancelled')"]
  }
}

-- Order versions loaded since the last run (everything on the first run).
WITH incoming AS (
  SELECT order_id, customer_id, restaurant_id, order_ts,
         DATE(order_ts) AS order_date,                       -- rule 7
         status, payment_method, updated_at, _export_date, _loaded_at
  FROM ${ref("stg_orders")}
  ${when(incremental(), `WHERE ${helpers.newRowsOnly(self())}`)}
),

-- Compete each incoming order against the version already in this table.
candidates AS (
  SELECT * FROM incoming
  ${when(incremental(), `
  UNION ALL
  SELECT order_id, customer_id, restaurant_id, order_ts, order_date,
         status, payment_method, updated_at, _export_date, _loaded_at
  FROM ${self()}
  WHERE order_id IN (SELECT order_id FROM incoming)`)}
),

-- Current state = latest updated_at (rule 1). Exact duplicate rows tie, and one is kept.
latest AS (
  SELECT * EXCEPT (version_rank)
  FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC, _loaded_at DESC) AS version_rank
    FROM candidates
  )
  WHERE version_rank = 1
)

-- Rule 4: only valid orders reach this table.
SELECT l.*
FROM latest l
WHERE l.customer_id IS NOT NULL
  AND l.restaurant_id IN (SELECT restaurant_id FROM ${ref("dim_restaurants")})
