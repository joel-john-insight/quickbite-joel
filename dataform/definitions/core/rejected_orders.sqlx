config {
  type: "table",
  description: "Rule 4: orders that must never reach the marts (unknown restaurant or no customer), current version, with the reason, so the business can follow up."
}

WITH latest AS (
  SELECT * EXCEPT (version_rank)
  FROM (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY updated_at DESC, _loaded_at DESC) AS version_rank
    FROM ${ref("stg_orders")}
  )
  WHERE version_rank = 1
)

SELECT
  l.order_id, l.customer_id, l.restaurant_id, l.order_ts, l.status, l.payment_method, l.updated_at,
  l._export_date AS source_export_date,
  CASE
    WHEN l.customer_id IS NULL AND r.restaurant_id IS NULL THEN 'missing customer_id and unknown restaurant_id'
    WHEN l.customer_id IS NULL                             THEN 'missing customer_id'
    ELSE CONCAT('unknown restaurant_id ', l.restaurant_id)
  END AS reject_reason
FROM latest l
LEFT JOIN ${ref("dim_restaurants")} r ON r.restaurant_id = l.restaurant_id
WHERE l.customer_id IS NULL OR r.restaurant_id IS NULL
